# Optional. The app works locally without a server and never calls one unless the learner enables «IA opcional».
# Default address and model offered in Configuración → IA opcional. The learner can override both there.
# Use an OpenAI-compatible server you trust, e.g. https://your-proxy.example/v1
# Do NOT put an API key here: VITE_ variables are public in the built bundle.
VITE_FORMA_AI_BASE_URL=
VITE_FORMA_AI_MODEL=
